# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# --- Anthropic ---
# Create a key at https://platform.claude.com (Settings > API keys).
ANTHROPIC_API_KEY=
# Model IDs: check https://platform.claude.com/docs/en/about-claude/models/overview
AGENT_MODEL=claude-sonnet-5-5
# Used only by the optional LLM-as-judge grader in the evaluation suite.
JUDGE_MODEL=claude-haiku-5-5
AGENT_MAX_TOKENS=1024
AGENT_MAX_ITERATIONS=6
MODEL_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=5

# --- Database ---
DATABASE_URL=postgresql://quilora:quilora_dev@localhost:5432/quilora

# --- Store clock ---
# Synthetic orders are dated around this day so return windows are deterministic.
# Leave empty to use the real current date.
STORE_TODAY=2026-10-01

# --- Policy search: fts | vector | hybrid ---
POLICY_SEARCH_BACKEND=fts
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Observability (OpenTelemetry) ---
# Set to the OTLP/HTTP endpoint of a collector or Jaeger, e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=quilora-assistant
# 1 = print spans to stdout (handy for local debugging)
OTEL_CONSOLE=0

# --- API ---
CORS_ORIGINS=http://localhost:4200
